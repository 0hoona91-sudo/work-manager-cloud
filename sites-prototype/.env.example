# Copy to .env locally; NEVER commit .env. Load with: set -a; . ./.env; set +a
# Local --dev generates a private development key automatically.
# Production requires a persistent encryption key from a secret manager.
APP_BASE_URL=http://127.0.0.1:8080
WM_DATA_DIR=.data
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# These are only for a documented confidential OIDC provider.
# No ChatGPT issuer, endpoint or client registration has been assumed.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
